PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bmw_premium_motors
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=
JWT_EXPIRES_IN=1h

# DEEPSEEK (Proveedor principal generativo: BMW Genius AI y PolicyBot RAG)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# OPENAI VISION (Uso exclusivo para OCR/análisis visual de PDF escaneados o imágenes)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

# EMBEDDINGS LOCALES (Hugging Face Transformers.js ONNX)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# GOOGLE DRIVE OAUTH 2.0 (Aplicaciones Web - sin Service Account JSON)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/drive/oauth/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# CIFRADO DE TOKENS GOOGLE EN MYSQL (AES-256-GCM, clave hexadecimal de 64 chars / 32 bytes)
TOKEN_ENCRYPTION_KEY=
