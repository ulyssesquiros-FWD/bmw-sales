{
  "name": "bmw-premium-motors-backend",
  "version": "1.0.0",
  "description": "API REST empresarial para concesionario BMW Premium Motors con Node.js, Express y MySQL",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node src/database/initDatabase.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed:modulos": "node src/database/seedModulosAdicionales.js",
    "db:seed:grande": "node src/database/seedGrande.js",
    "db:seed:nuevas": "node src/database/seedNuevasEntidades.js",
    "db:seed:all": "node src/database/seedModulosAdicionales.js && node src/database/seedGrande.js && node src/database/seedNuevasEntidades.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.12.0"
  }
}
